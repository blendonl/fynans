POSTGRES_USER=admin
POSTGRES_PASSWORD=admin
POSTGRES_DB=db

BETTER_AUTH_SECRET=your-secret-key-minimum-32-characters-long-change-this-in-production
BETTER_AUTH_URL=http://localhost:3001

NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# Public contact address shown in the landing page footer and the legal pages.
# Leave empty to hide the footer Contact link entirely.
NEXT_PUBLIC_CONTACT_EMAIL=

CORS_ORIGIN=http://localhost:3000

# Ports
WEB_PORT=3000
BACKEND_PORT=3001
POSTGRES_PORT=5432
REDIS_PORT=6379
PADDLEOCR_PORT=8000
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

COOKIE_DOMAIN=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=

# MinIO / S3-compatible storage
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=fynans
MINIO_REGION=us-east-1
MINIO_ENDPOINT=http://localhost:9000

# PaddleOCR (requires --profile paddle, or set URL to external instance)
PADDLEOCR_SERVICE_URL=http://paddleocr:8000
PADDLEOCR_TIMEOUT=30000

# OCR engine: "paddleocr" (default)
OCR_ENGINE=paddleocr

# Web Push Notifications (VAPID keys)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# GitHub Copilot API (optional)
COPILOT_ACCESS_TOKEN=
COPILOT_REFRESH_TOKEN=
COPILOT_TOKEN_EXPIRES=
COPILOT_MODEL=claude-sonnet-4-20250514
COPILOT_FALLBACK_MODEL=gpt-4o
COPILOT_TIMEOUT=30000
COPILOT_API_ENDPOINT=

# Receipt processing
RECEIPT_NORMALIZE_NAMES=false

# Session cookies
# The web app authenticates with better-auth's httpOnly session cookie, and the
# Next.js middleware reads it to tell signed-in from signed-out. That cookie is
# set by the API origin, so when the web app and the API are on different hosts
# COOKIE_DOMAIN must be a parent domain shared by both (e.g. .fynans.app).
# Leave it empty for localhost, where the cookie is host-only and shared across
# ports. Cookies are Secure + SameSite=None when NODE_ENV=production or
# BETTER_AUTH_URL is https, and SameSite=Lax over plain HTTP.
