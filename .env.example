POSTGRES_USER=admin
POSTGRES_PASSWORD=admin
POSTGRES_DB=db

BETTER_AUTH_SECRET=your-secret-key-minimum-32-characters-long-change-this-in-production
BETTER_AUTH_URL=http://localhost:3001

NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

CORS_ORIGIN=http://localhost:3000

# Ports
WEB_PORT=3000
BACKEND_PORT=3001
POSTGRES_PORT=5432
REDIS_PORT=6379
OLLAMA_PORT=11434
DONUT_PORT=8001
PADDLEOCR_PORT=8000
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

COOKIE_DOMAIN=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=

# MinIO / S3-compatible storage
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=fynans
MINIO_REGION=us-east-1
MINIO_ENDPOINT=http://localhost:9000

# Ollama (LLM for receipt parsing)
# Use the "ollama" docker-compose profile to run locally, or set URL to external instance
OLLAMA_SERVICE_URL=http://ollama:11434
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_VISION_MODEL=qwen2.5vl:3b
OLLAMA_TIMEOUT=180000
OLLAMA_KEEP_ALIVE=30m

# PaddleOCR (requires --profile paddle, or set URL to external instance)
PADDLEOCR_SERVICE_URL=http://paddleocr:8000
PADDLEOCR_TIMEOUT=30000

# OCR engine: "paddleocr" (default)
OCR_ENGINE=paddleocr

# Donut CORD vision parser (requires --profile donut and nvidia-docker)
VISION_PARSER=ollama
DONUT_SERVICE_URL=http://donut:8001
DONUT_TIMEOUT=120000

# Web Push Notifications (VAPID keys)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# AI / Copilot (optional)
COPILOT_CATEGORY_MODEL=
COPILOT_API_ENDPOINT=

# OpenCode receipt parser (optional)
OPENCODE_MODEL=
OPENCODE_TIMEOUT=60000

# Receipt processing
RECEIPT_NORMALIZE_NAMES=false
