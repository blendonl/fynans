generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id String @id @default(uuid())

  email     String  @unique
  name      String  @default("")
  firstName String  @default("") @map("first_name")
  lastName  String  @default("") @map("last_name")
  image     String?

  emailVerified Boolean @default(false) @map("email_verified")

  reportingCurrency String @map("reporting_currency") @db.Char(3)

  transactions Transaction[]
  accounts     Account[]
  sessions     Session[]

  // Family relationships
  familyMemberships   FamilyMember[]
  sentInvitations     FamilyInvitation[] @relation("sent_invitations")
  receivedInvitations FamilyInvitation[] @relation("received_invitations")

  // Notification relationships
  notifications          Notification[]
  notificationPreference NotificationPreference?
  deviceTokens           DeviceToken[]
  webPushSubscriptions   WebPushSubscription[]

  // Basket relationships
  baskets Basket[]

  // User-scoped entity relationships
  expenseCategories     ExpenseCategory[]
  incomeCategories      IncomeCategory[]
  items                 Item[]
  userStores            UserStore[]
  userStoreItems        UserStoreItem[]
  userItemCategories    UserItemCategory[]

  // Payment methods
  paymentMethods PaymentMethod[]

  // Receipts
  receipts Receipt[]

  financialAuditLogs FinancialAuditLog[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("users")
}
