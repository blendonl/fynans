DATABASE_URL="postgresql://admin:admin@localhost:5432/db"

BETTER_AUTH_SECRET="your-secret-key-minimum-32-characters-long-change-this-in-production"
BETTER_AUTH_URL="http://localhost:3001"

CORS_ORIGIN="http://localhost:3000"

COOKIE_DOMAIN=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# PaddleOCR
PADDLEOCR_SERVICE_URL=http://localhost:8000
PADDLEOCR_TIMEOUT=30000

# OCR engine: "paddleocr" (default)
OCR_ENGINE=paddleocr

# Ollama (LLM for receipt parsing)
OLLAMA_SERVICE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_VISION_MODEL=qwen2.5vl:3b
OLLAMA_TIMEOUT=180000

# Vision parser: "ollama" (default) or "donut"
VISION_PARSER=ollama
DONUT_SERVICE_URL=http://localhost:8001
DONUT_TIMEOUT=120000

# Web Push Notifications (VAPID keys)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
